# ---------------------------------------------------------------------------
# Green Corner — Backend environment variables
# Copy this file to `.env` and adjust the values for your environment.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# Local dev (docker compose): the value below points at the local container.
# Production (Neon): paste the Neon connection string here instead, e.g.
#   DATABASE_URL="postgresql://user:password@ep-cool-db.neon.tech/green_corner?sslmode=require"
DATABASE_URL="postgresql://green_corner:green_corner@localhost:5432/green_corner?schema=public"

# Secret used to sign JWT access tokens. Use a long random string in production.
JWT_SECRET="change-me-to-a-long-random-string"

# Port the NestJS API listens on.
PORT=4000

# Comma-separated list of allowed CORS origins.
FRONTEND_URL="http://localhost:3000"

# Absolute or relative path used to serve uploaded product images.
UPLOAD_DIR="uploads"
